                   StripOnInput->False],
                  "\"Definitions\"",
                  TooltipStyle->"TextStyling"],
                 Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    RowBox[{"CombineSqrts", "[", "expr_", "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", "result", "}"}], ",", 
                    RowBox[{
                    RowBox[{"result", "=", "expr"}], ";", 
                    RowBox[{"result", "=", 
                    RowBox[{"Expand", "[", "result", "]"}]}], ";", 
                    RowBox[{"result", "=", 
                    RowBox[{"FixedPoint", "[", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{"x", ",", 
                    RowBox[{"x", "//.", "\[VeryThinSpace]", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    SqrtBox["a_"], " ", 
                    SqrtBox["b_"]}], "\[RuleDelayed]", 
                    SqrtBox[
                    RowBox[{"Expand", "[", 
                    RowBox[{"a", " ", "b"}], "]"}]]}], ",", 
                    RowBox[{
                    FractionBox[
                    SqrtBox["a_"], 
                    SqrtBox["b_"]], "\[RuleDelayed]", 
                    SqrtBox[
                    RowBox[{"Expand", "[", 
                    FractionBox["a", "b"], "]"}]]}], ",", 
                    RowBox[{
                    RowBox[{"pre___", " ", 
                    SqrtBox["a_"], " ", 
                    SqrtBox["b_"], " ", "post___"}], "\[RuleDelayed]", 
                    RowBox[{"pre", " ", 
                    SqrtBox[
                    RowBox[{"Expand", "[", 
                    RowBox[{"a", " ", "b"}], "]"}]], " ", "post"}]}], ",", 
                    RowBox[{
                    RowBox[{"pre___", " ", 
                    SqrtBox["a_"], " ", 
                    SqrtBox["b_"], " ", 
                    SqrtBox["c_"], " ", "post___"}], "\[RuleDelayed]", 
                    RowBox[{"pre", " ", 
                    SqrtBox[
                    RowBox[{"Expand", "[", 
                    RowBox[{"a", " ", "b", " ", "c"}], "]"}]], " ", 
                    "post"}]}], ",", 
                    RowBox[{
                    RowBox[{"pre___", " ", 
                    SqrtBox["a_"], " ", 
                    SqrtBox["b_"], " ", 
                    SqrtBox["c_"], " ", 
                    SqrtBox["d_"], " ", "post___"}], "\[RuleDelayed]", 
                    RowBox[{"pre", " ", 
