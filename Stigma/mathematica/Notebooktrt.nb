Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"LTemp", ":=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"L", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"t", "[", "]"}], "->", "t"}], "}"}]}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"aa", "[", "t", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"nn", "[", "t", "]"}], ">", "0"}]}], "}"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lnew", ":=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"LTemp", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sig1", "->", 
          RowBox[{"sig2", " ", "stigma"}]}], ",", 
         RowBox[{"ups1", "->", "0"}], ",", 
         RowBox[{
          RowBox[{"Psis", "[", "t", "]"}], "->", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Mp", " ", 
             RowBox[{"Sqrt", "[", "ups2", "]"}], " ", 
             RowBox[{"Varpis", "[", "t", "]"}]}], ")"}], "/", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"4", " ", "sig2", " ", "stigma"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", "1", "]"}], "[", "Psis", "]"}], "[", 
           "t", "]"}], "->", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Mp", " ", 
             RowBox[{"Sqrt", "[", "ups2", "]"}], " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Derivative", "[", "1", "]"}], "[", "Varpis", "]"}], "[",
               "t", "]"}]}], ")"}], "/", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"4", " ", "sig2", " ", "stigma"}], "]"}]}]}]}], "}"}]}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"aa", "[", "t", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"nn", "[", "t", "]"}], ">", "0"}]}], "}"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Print", 
  "@", "\"\<With the substitution for psi[] and sig1, the Lagrangian \
becomes\>\""}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "@", 
    RowBox[{"(", "Lnew", ")"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Eqn", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", "it"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"Lnew", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Derivative", "[", "it", "]"}], "[", "nn", "]"}], "[", 
             "t", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "it"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"it", ",", "0", ",", "2"}], "}"}]}], "]"}], "-", 
     RowBox[{
      RowBox[{"Rhos", "[", "t", "]"}], " ", 
      RowBox[{
       RowBox[{"aa", "[", "t", "]"}], "^", "3"}]}]}], "//", 
    "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Eqa", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", "it"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"Lnew", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Derivative", "[", "it", "]"}], "[", "aa", "]"}], "[", 
             "t", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "it"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"it", ",", "0", ",", "2"}], "}"}]}], "]"}], "+", 
     RowBox[{"3", " ", 
      RowBox[{"P", "[", "t", "]"}], " ", 
      RowBox[{
       RowBox[{"aa", "[", "t", "]"}], "^", "2"}]}]}], "//", 
    "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"EqPhi", "=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", "it"}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"Lnew", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", "it", "]"}], "[", "Phis", "]"}], "[", 
            "t", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "it"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"it", ",", "0", ",", "2"}], "}"}]}], "]"}], "//", 
    "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"EqVarpi", "=", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", "it"}], " ", 
        RowBox[{"D", "[", 
