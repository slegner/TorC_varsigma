       RowBox[{"{", 
        RowBox[{"it", ",", "0", ",", "2"}], "}"}]}], "]"}], "//", 
     "FullSimplify"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nn", "[", "t_", "]"}], ":=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefScalarFunction", "[", 
   RowBox[{"rhom", ",", 
    RowBox[{
    "PrintAs", 
     "->", "\"\<\\(\\*SubscriptBox[\\(\[Rho]\\), \\(m\\)]\\)\>\""}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"DefScalarFunction", "[", 
   RowBox[{"rhor", ",", 
    RowBox[{
    "PrintAs", 
     "->", "\"\<\\(\\*SubscriptBox[\\(\[Rho]\\), \\(r\\)]\\)\>\""}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"DefScalarFunction", "[", 
   RowBox[{"rhoL", ",", 
    RowBox[{
    "PrintAs", 
     "->", "\"\<\\(\\*SubscriptBox[\\(\[Rho]\\), \\(\[CapitalLambda]\\)]\\)\>\
\""}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Rhos", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"rhom", "[", "t", "]"}], "+", 
    RowBox[{"rhor", "[", "t", "]"}], "+", 
    RowBox[{"rhoL", "[", "t", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"P", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "3"}], " ", 
      RowBox[{"rhor", "[", "t", "]"}]}], "-", 
     RowBox[{"rhoL", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Phis", "[", "t_", "]"}], "=", 
    RowBox[{
     RowBox[{"Phis", "[", "t", "]"}], "/.", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"EqPhi", "==", "0"}], ",", 
        RowBox[{"Phis", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"EqnFinal", "=", 
   RowBox[{"Eqn", "//", "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"EqaFinal", "=", 
   RowBox[{"Eqa", "//", "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"EqVarpiFinal", "=", 
    RowBox[{"EqVarpi", "//", "FullSimplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "@", "\"\<After applying constraints and solving phi \
equation:\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "@", "\"\<Final Equation for N (lapse function):\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "@", 
   RowBox[{"(", "EqnFinal", ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "@", "\"\<Final Equation for a (scale factor):\>\""}], 
