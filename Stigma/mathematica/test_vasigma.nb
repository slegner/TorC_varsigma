e292aed4a572"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Eqn", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "it"], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"Lnew", ",", 
            RowBox[{
             SuperscriptBox["nn", 
              TagBox[
               RowBox[{"(", "it", ")"}],
               Derivative],
              MultilineFunction->None], "[", "t", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "it"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"it", ",", "0", ",", "2"}], "}"}]}], "]"}], "-", " ", 
     RowBox[{
      RowBox[{"\[Rho]", "[", "t", "]"}], " ", 
      SuperscriptBox[
       RowBox[{"aa", "[", "t", "]"}], "3"]}]}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Eqa", "=", 
