Cell["\<\
As one can see from the above equations, \[Rho][t] and P[t] are added to the \
Equations of motion as a variation of the energy-momentum tensor.
We want to write the energy density and pressure in terms of the big Omegas:\
\>", "Text",
 CellChangeTimes->{{3.919233684695866*^9, 3.919233722267405*^9}, {
  3.919234135569295*^9, 3.919234164017584*^9}, {3.919234248123068*^9, 
  3.919234265867106*^9}},ExpressionUUID->"6a077daf-4d85-4559-9f56-\
d8df60a0dd70"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]m", "[", "t_", "]"}], ":=", " ", 
     RowBox[{"3", 
      SuperscriptBox["Mp", "2"], " ", 
      SuperscriptBox["H00", "2"], " ", "\[CapitalOmega]m0", " ", 
      SuperscriptBox[
       RowBox[{"aa", "[", "t", "]"}], 
       RowBox[{"-", "3"}]]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Rho]r", "[", "t_", "]"}], ":=", " ", 
     RowBox[{"3", 
      SuperscriptBox["Mp", "2"], 
      SuperscriptBox["H00", "2"], "\[CapitalOmega]r0", " ", 
      SuperscriptBox[
       RowBox[{"aa", "[", "t", "]"}], 
       RowBox[{"-", "4"}]]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]\[CapitalLambda]", "[", "t_", "]"}], ":=", 
     RowBox[{"3", 
      SuperscriptBox["Mp", "2"], 
      SuperscriptBox["H00", "2"], "\[CapitalOmega]\[CapitalLambda]0"}]}], 
    ";"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"\[Rho]m", "[", "t", "]"}], "+", 
      RowBox[{"\[Rho]r", "[", "t", "]"}], "+", 
      RowBox[{"\[Rho]\[CapitalLambda]", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"P", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       FractionBox["1", "3"], 
       RowBox[{"\[Rho]r", "[", "t", "]"}]}], "-", 
      RowBox[{"\[Rho]\[CapitalLambda]", "[", "t", "]"}]}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{
  3.919234482743537*^9, {3.919234518550901*^9, 3.919234601868931*^9}, {
   3.954827160845387*^9, 3.954827165038583*^9}, 3.954827372419363*^9, {
   3.954908867890073*^9, 3.95490887193919*^9}, {3.955793489839343*^9, 
   3.955793495193364*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"4a114a1f-a9dd-40e0-a7ce-4088b632dfdc"],

Cell["\<\
One more thing we note is that the third equation gives a definition of \
\[Phi] which significantly simplifies the rest of the equations\
\>", "Text",
