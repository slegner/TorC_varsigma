Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"s", "=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"d\[CurlyPi]", "'"}], "[", "\[Tau]", "]"}], " ", "==", 
        RowBox[{"Diffd\[CurlyPi]", "[", "\[Tau]", "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"da", "'"}], "[", "\[Tau]", "]"}], "==", 
        RowBox[{"Diffda", "[", "\[Tau]", "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"aa", "'"}], "[", "\[Tau]", "]"}], " ", "==", " ", 
        RowBox[{"da", "[", "\[Tau]", "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CurlyPi]", "'"}], "[", "\[Tau]", "]"}], " ", "==", " ", 
        RowBox[{"d\[CurlyPi]", "[", "\[Tau]", "]"}]}], ",", 
       RowBox[{
        RowBox[{"aa", "[", "\[Tau]ini", "]"}], " ", "==", " ", "aini"}], ",", 
       
       RowBox[{
        RowBox[{"\[CurlyPi]", "[", "\[Tau]ini", "]"}], " ", "==", " ", 
        "\[CurlyPi]ini"}], ",", " ", 
       RowBox[{
        RowBox[{"da", "[", "\[Tau]ini", "]"}], " ", "==", " ", "daini"}], ",",
        "  ", 
       RowBox[{
        RowBox[{"d\[CurlyPi]", "[", "\[Tau]ini", "]"}], " ", "==", 
        "d\[CurlyPi]ini"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "\[CurlyPi]", ",", " ", "aa", ",", " ", "d\[CurlyPi]", ",", " ", "da"}],
       "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", "\[Tau]ini", ",", "10"}], "}"}], ",", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<DiscontinuityProcessing\>\"", "->", "False"}], "}"}]}]}], 
    "]"}], "]"}]}]], "Input",
 CellLabel->
  "In[401]:=",ExpressionUUID->"98a07e68-ba5b-4a0f-8b39-5d0f014262b2"],

