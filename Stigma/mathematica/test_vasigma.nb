Cell[TextData[{
 "The two equations above are the same, but when I plug in ",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalOmega]r0", " ", "=", 
     RowBox[{"8.538168828264762", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "5"}]]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Radiation", " ", "density", " ", "today"}], "*)"}]}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalOmega]m0", " ", "=", " ", 
     RowBox[{"0.3089", "-", 
      FractionBox["\[CapitalOmega]r0", "2"]}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Matter", " ", "density", " ", "today"}], "*)"}]}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalOmega]\[CapitalLambda]0", " ", "=", " ", "0.7"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Chosen", " ", "dark", " ", "energy", " ", "density"}], 
    "*)"}]}], "\[IndentingNewLine]", 
  RowBox[{"\[CapitalOmega]L", " ", "=", " ", "0.7"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"H00", " ", "=", " ", "70"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Hubble", " ", "constant"}], "*)"}]}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Alpha]", " ", "=", " ", "1"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Rescaling", " ", "factor", " ", "for", " ", "a", 
     RowBox[{"(", "t", ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Stigma]", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[CurlyPi]r", " ", "=", " ", "0.9"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Tau]ini", " ", "=", " ", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Upsilon]2", " ", "=", " ", 
    RowBox[{
     RowBox[{"-", "4"}], "/", "3"}]}], ";"}]}],
  CellChangeTimes->{{3.96535626942362*^9, 3.96535629927918*^9}, {
    3.965356393484639*^9, 3.9653563966000443`*^9}, 3.965356595768437*^9, {
    3.965358744273065*^9, 3.9653587479776077`*^9}, {3.965359114572728*^9, 
    3.9653591153874197`*^9}, {3.9653591487928143`*^9, 3.965359152164364*^9}, 
    3.965359216875646*^9, {3.965362440066573*^9, 3.9653624578581343`*^9}},
  ExpressionUUID->"b507c012-1b33-4a2d-a18f-ac989c0223d4"],
 " one is negative and the other is positive"
}], "ChatInput",
 CellChangeTimes->{{3.965394781226508*^9, 3.965394811572406*^9}},
 CellLabel->
  "In[619]:=",ExpressionUUID->"ff79deec-f9cd-4cac-8577-f181ffdae545"],

