          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "43"}], "+", 
            RowBox[{"7", " ", 
             RowBox[{"(", 
              RowBox[{"5", "-", 
               RowBox[{"4", " ", "\[Stigma]"}]}], ")"}], " ", "\[Stigma]"}]}],
            ")"}]}]}], ")"}]}], "-", 
      RowBox[{
       SuperscriptBox["\[CurlyPi]r", "6"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], "+", "\[Stigma]", "+", 
         RowBox[{
          SuperscriptBox["\[Stigma]", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"7", "+", 
            RowBox[{"4", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "\[Stigma]"}], ")"}], " ", 
             "\[Stigma]"}]}], ")"}]}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["\[CurlyPi]r", "4"], " ", "\[Stigma]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "7"}], "+", "\[Stigma]", "+", 
         RowBox[{"8", " ", 
          SuperscriptBox["\[Stigma]", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"4", "+", 
            RowBox[{"\[Stigma]", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "3"}], "+", 
               RowBox[{"2", " ", "\[Stigma]"}]}], ")"}]}]}], ")"}]}]}], 
        ")"}]}]}], ")"}]}]]}]], "Output",
