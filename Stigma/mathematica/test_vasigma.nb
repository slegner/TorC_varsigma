         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"Lnew", ",", 
            RowBox[{
             SuperscriptBox["aa", 
              TagBox[
               RowBox[{"(", "it", ")"}],
               Derivative],
              MultilineFunction->None], "[", "t", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "it"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"it", ",", "0", ",", "2"}], "}"}]}], "]"}], "+", " ", 
     RowBox[{"3", 
      RowBox[{"P", "[", "t", "]"}], " ", 
      SuperscriptBox[
       RowBox[{
        InterpretationBox[
