               "}"}]}]}], "]"}], ",", "result"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Final", " ", "aggressive", " ", "simplification"}], "*)"}], 
        
        RowBox[{"result", "=", 
         RowBox[{"PowerExpand", "[", 
          RowBox[{"FullSimplify", "[", "result", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "result"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ToPython", "[", "expr_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "result", "}"}], ",", 
       RowBox[{
        RowBox[{"result", "=", "expr"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Skip", " ", "complex", " ", "square", " ", "root", " ", 
          "combination", " ", "to", " ", "avoid", " ", "recursion"}], "*)"}], 
        
        RowBox[{"(*", 
         RowBox[{"Convert", " ", "to", " ", "string"}], "*)"}], 
        RowBox[{"result", "=", 
         RowBox[{"ToString", "[", 
          RowBox[{"result", ",", "InputForm"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Enhanced", " ", "replacements", " ", "including", " ", "Greek", " ",
           "letters"}], "*)"}], 
        RowBox[{"result", "=", 
         RowBox[{"StringReplace", "[", 
          RowBox[{"result", ",", 
           RowBox[{"{", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
               RowBox[{
               "Handle", " ", "Greek", " ", "letters", " ", "and", " ", 
                "special", " ", "characters"}], "-", 
               RowBox[{"\\[", "name", "]"}]}], "->", "name"}], "*)"}], 
            RowBox[{
             RowBox[{
              RowBox[{
              "RegularExpression", 
               "[", "\"\<\\\\\\\\\\\\[([^\\\\]]+)\\\\\\\\\\\\]\>\"", "]"}], 
              "->", "\"\<$1\>\""}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
                RowBox[{
                "Handle", " ", "Sqrt", " ", "specifically", " ", "first"}], "-", 
                RowBox[{"Sqrt", "[", "x", "]"}]}], "->", 
               RowBox[{
                RowBox[{"(", "x", ")"}], "**", 
                RowBox[{"(", 
                 RowBox[{"1", "/", "2"}], ")"}]}]}], "*)"}], 
             RowBox[{
              RowBox[{
              "RegularExpression", "[", "\"\<Sqrt\\\\[([^\\\\]]+)\\\\]\>\"", 
               "]"}], "->", "\"\<($1)**(1/2)\>\""}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
                RowBox[{"Handle", " ", "Power", " ", "function"}], "-", 
                RowBox[{"Power", "[", 
                 RowBox[{"x", ",", "y"}], "]"}]}], "->", 
               RowBox[{
                RowBox[{"(", "x", ")"}], "**", 
                RowBox[{"(", "y", ")"}]}]}], "*)"}], 
             RowBox[{
              RowBox[{
              "RegularExpression", 
               "[", "\"\<Power\\\\[([^,]+),\\\\s*([^\\\\]]+)\\\\]\>\"", "]"}],
               "->", "\"\<($1)**($2)\>\""}], ",", 
             RowBox[{"(*", 
              RowBox[{"Trigonometric", " ", "functions"}], "*)"}], 
             RowBox[{"\"\<Sin[\>\"", "->", "\"\<sin(\>\""}], ",", 
             RowBox[{"\"\<Cos[\>\"", "->", "\"\<cos(\>\""}], ",", 
             RowBox[{"\"\<Tan[\>\"", "->", "\"\<tan(\>\""}], ",", 
             RowBox[{"\"\<ArcSin[\>\"", "->", "\"\<asin(\>\""}], ",", 
             RowBox[{"\"\<ArcCos[\>\"", "->", "\"\<acos(\>\""}], ",", 
             RowBox[{"\"\<ArcTan[\>\"", "->", "\"\<atan(\>\""}], ",", 
             RowBox[{"\"\<Sinh[\>\"", "->", "\"\<sinh(\>\""}], ",", 
             RowBox[{"\"\<Cosh[\>\"", "->", "\"\<cosh(\>\""}], ",", 
             RowBox[{"\"\<Tanh[\>\"", "->", "\"\<tanh(\>\""}], ",", 
             RowBox[{"(*", 
              RowBox[{"Other", " ", "mathematical", " ", "functions"}], 
              "*)"}], 
             RowBox[{"\"\<Log[\>\"", "->", "\"\<log(\>\""}], ",", 
             RowBox[{"\"\<Exp[\>\"", "->", "\"\<exp(\>\""}], ",", 
             RowBox[{"\"\<Abs[\>\"", "->", "\"\<abs(\>\""}], ",", 
             RowBox[{"(*", "Constants", "*)"}], 
             RowBox[{"\"\<Pi\>\"", "->", "\"\<pi\>\""}], ",", 
             RowBox[{"\"\<E\>\"", "->", "\"\<e\>\""}], ",", 
             RowBox[{"\"\<I\>\"", "->", "\"\<1j\>\""}], ",", 
             RowBox[{"(*", 
              RowBox[{
              "Replace", " ", "remaining", " ", "brackets", " ", "with", " ", 
               "parentheses"}], "*)"}], 
             RowBox[{"\"\<[\>\"", "->", "\"\<(\>\""}], ",", 
             RowBox[{"\"\<]\>\"", "->", "\"\<)\>\""}]}], "}"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Second", " ", 
          RowBox[{"pass", ":", 
           RowBox[{"Handle", " ", 
            RowBox[{"all", "^", "characters"}], " ", "more", " ", 
            "aggressively"}]}]}], "*)"}], 
        RowBox[{"result", "=", 
         RowBox[{"StringReplace", "[", 
          RowBox[{"result", ",", 
           RowBox[{"\"\<^\>\"", "->", "\"\<**\>\""}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Third", " ", 
          RowBox[{"pass", ":", 
           RowBox[{
           "Use", " ", "regex", " ", "to", " ", "catch", " ", "any", " ", 
            "remaining", " ", "exponential", " ", "patterns"}]}]}], "*)"}], 
        RowBox[{"result", "=", 
         RowBox[{"StringReplace", "[", 
          RowBox[{"result", ",", 
           RowBox[{
            RowBox[{
            "RegularExpression", 
             "[", "\"\<([a-zA-Z0-9_]+)\\\\^([a-zA-Z0-9_]+)\>\"", "]"}], 
            "->", "\"\<$1**$2\>\""}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        "result"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== PYTHON CONVERSION OF TAU INITIAL ===\>\"", 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Convert", " ", "the", " ", "tauini", " ", "expression", " ", "to", " ", 
     "Python", " ", "format"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "aSolutions", "]"}], ">=", "2"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<Converting tauiniRobust to Python format:\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Clear", " ", "any", " ", "potential", " ", "symbol", " ", 
         "contamination"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{"Simple", " ", 
         RowBox[{"a1", "/", "a2"}], " ", "expression", " ", "for", " ", 
         "Python"}], "*)"}], 
       RowBox[{"tauiniSimpleExpr", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"a1", "/", "a2"}], ")"}], "*", 
         RowBox[{"10", "^", 
          RowBox[{"(", 
           RowBox[{"-", "6"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tauiniWithPythonVars", "=", 
        RowBox[{"tauiniSimpleExpr", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"OmegaM0", "->", "omega_m"}], ",", 
           RowBox[{"VarPi0", "->", "cpr"}], ",", 
           RowBox[{"ups2", "->", "v2"}], ",", 
           RowBox[{"H0", "->", 
            RowBox[{"h", "*", "100"}]}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Convert", " ", "to", " ", "Python"}], "*)"}], 
       RowBox[{"tauiniPython", "=", 
        RowBox[{"tauiniWithPythonVars", "//", "ToPython"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<tauiniRobust //ToPython = \>\"", ",", "tauiniPython"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<COPY-PASTE READY FOR PYTHON:\>\"", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<tauini_robust = \>\"", ",", "tauiniPython"}], "]"}], 
       ";"}]}], "]"}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.967462217370591*^9, 3.967462237601255*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"74741596-c715-49cd-8e17-d5ab7286947d"],

