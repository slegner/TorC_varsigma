 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "A1Sol", "]"}], ">", "0"}], ",", 
      RowBox[{
       RowBox[{"AllBranchSolutions", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"currentA1", "=", 
           RowBox[{"A1Sol", "[", 
            RowBox[{"[", "branchNum", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ZeroOrderConstraintSub", "=", 
           RowBox[{
            RowBox[{"ZeroOrderConstraint", "/.", " ", "currentA1"}], "//", 
            "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"ZeroOrderVarPiSub", "=", 
           RowBox[{
            RowBox[{"ZeroOrderVarPi", "/.", " ", "currentA1"}], "//", 
            "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"A2Pi1Sol", "=", 
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ZeroOrderConstraintSub", "==", "0"}], ",", 
               RowBox[{"ZeroOrderVarPiSub", "==", "0"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"VarPi1", ",", "ScaleFactor2"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"A2Pi1Sol", "=", 
