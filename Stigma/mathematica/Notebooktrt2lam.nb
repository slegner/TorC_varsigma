    RowBox[{
    "PrintAs", 
     "->", "\"\<\\(\\*SubscriptBox[\\(\[Rho]\\), \\(m\\)]\\)\>\""}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"DefScalarFunction", "[", 
   RowBox[{"rhor", ",", 
    RowBox[{
    "PrintAs", 
