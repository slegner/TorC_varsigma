    RowBox[{
    "PrintAs", 
     "->", "\"\<\\(\\*SubscriptBox[\\(\[Rho]\\), \\(\[CapitalLambda]\\)]\\)\>\
\""}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Rhos", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"rhom", "[", "t", "]"}], "+", 
    RowBox[{"rhor", "[", "t", "]"}], "+", 
    RowBox[{"rhoL", "[", "t", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"P", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "3"}], " ", 
      RowBox[{"rhor", "[", "t", "]"}]}], "-", 
     RowBox[{"rhoL", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Phis", "[", "t_", "]"}], "=", 
    RowBox[{
     RowBox[{"Phis", "[", "t", "]"}], "/.", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"EqPhi", "==", "0"}], ",", 
        RowBox[{"Phis", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"EqnFinal", "=", 
   RowBox[{"Eqn", "//", "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"EqaFinal", "=", 
   RowBox[{"Eqa", "//", "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"EqVarpiFinal", "=", 
    RowBox[{"EqVarpi", "//", "FullSimplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
