          "\[IndentingNewLine]", 
          RowBox[{"branchSols", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"currentA1", ",", "A2Pi1Sol"}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"AllBranchSolutions", ",", "branchSols"}], "]"}], ";"}], ",", 
         RowBox[{"{", 
          RowBox[{"branchNum", ",", "1", ",", 
           RowBox[{"Length", "[", "A1Sol", "]"}]}], "}"}]}], "]"}], ";"}]}], 
     "]"}], ";"}], "\n"}]}]], "Input",
