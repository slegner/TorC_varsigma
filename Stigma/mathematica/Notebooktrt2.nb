             RowBox[{
              RowBox[{"Derivative", "[", "it", "]"}], "[", "aa", "]"}], "[", 
             "t", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "it"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"it", ",", "0", ",", "2"}], "}"}]}], "]"}], "+", 
     RowBox[{"3", " ", 
      RowBox[{"P", "[", "t", "]"}], " ", 
      RowBox[{
       RowBox[{"aa", "[", "t", "]"}], "^", "2"}]}]}], "//", 
    "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"EqPhi", "=", 
