Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Expand", " ", "the", " ", "full", " ", "constraint", " ", "equation"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"F1expand", "=", 
    RowBox[{"F1", "//", "Expand"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Replace", " ", "derivative", " ", "terms", " ", "with", " ", 
     RowBox[{"H", "^", "2"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"F1tau", "=", 
    RowBox[{
     RowBox[{"F1expand", "/.", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", "1", "]"}], "[", "aa", "]"}], "[", "Tau",
          "]"}], "^", "2"}], "->", 
       RowBox[{"HH2", "/", 
        RowBox[{"alps", "^", "2"}]}]}]}], "//", "FullSimplify"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Solve", " ", "for", " ", 
     RowBox[{"H", "^", "2"}], " ", "in", " ", "full", " ", "Stigma", " ", 
     "theory"}], "*)"}], "\n", 
   RowBox[{"F1Htau", "=", 
    RowBox[{
     RowBox[{"HH2", "/.", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"F1tau", "==", "0"}], ",", "HH2"}], "]"}], "]"}]}], "//", 
     "FullSimplify"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Find", " ", "effective", " ", "dark", " ", "energy", " ", "density", " ",
      "by", " ", "equating", " ", "GR", " ", "and", " ", "Stigma", " ", 
     "Hubble", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"rhoe", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"rhoLeff", "[", "Tau", "]"}], "/.", " ", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"F1GRH2", "==", "F1Htau"}], ",", 
           RowBox[{"rhoLeff", "[", "Tau", "]"}]}], "]"}], "]"}]}], "/.", " ", 
       "rhorules"}], "/.", " ", "rhorulesGR"}], "//", "FullSimplify"}]}], 
   "\[IndentingNewLine]", "\n"}]}]], "Input",
