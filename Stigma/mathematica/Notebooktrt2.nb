Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefChart", "[", 
   RowBox[{"ch", ",", "M", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "[", "]"}], ",", 
      RowBox[{"x", "[", "]"}], ",", 
      RowBox[{"y", "[", "]"}], ",", 
      RowBox[{"z", "[", "]"}]}], "}"}], ",", 
    RowBox[{"ChartColor", "->", "Purple"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"DefScalarFunction", "[", 
   RowBox[{"nn", ",", 
    RowBox[{"PrintAs", "->", "\"\<N\>\""}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DefScalarFunction", "[", 
    RowBox[{"aa", ",", 
     RowBox[{"PrintAs", "->", "\"\<a\>\""}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"metricmatrix", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"nn", "[", 
         RowBox[{"t", "[", "]"}], "]"}], "^", "2"}], ",", "0", ",", "0", ",", 
       "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"aa", "[", 
          RowBox[{"t", "[", "]"}], "]"}], "^", "2"}]}], ",", "0", ",", "0"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"aa", "[", 
          RowBox[{"t", "[", "]"}], "]"}], "^", "2"}]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"aa", "[", 
          RowBox[{"t", "[", "]"}], "]"}], "^", "2"}]}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"metric", "=", 
  RowBox[{"CTensor", "[", 
   RowBox[{"metricmatrix", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "ch"}], ",", 
      RowBox[{"-", "ch"}]}], "}"}]}], "]"}]}], "\n", 
 RowBox[{"SetCMetric", "[", 
  RowBox[{"metric", ",", "ch", ",", 
   RowBox[{"SignatureOfMetric", "->", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3", ",", "0"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"cd", "=", 
  RowBox[{"CovDOfMetric", "[", "metric", "]"}]}], "\n", 
 RowBox[{"detg", "=", 
  RowBox[{"Det", "[", "metricmatrix", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Riemanncd", "=", 
   RowBox[{"Riemann", "[", "cd", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Riccicd", "=", 
   RowBox[{"Ricci", "[", "cd", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RicciScalarcd", "=", 
    RowBox[{"RicciScalar", "[", "cd", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "@", 
   RowBox[{"(", 
    RowBox[{"RicciScalarcd", "//", "Simplify"}], ")"}]}], 
  ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.988105377950644*^9, 3.988105377953154*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"b753294b-109a-43db-88c2-5096675bb072"],

