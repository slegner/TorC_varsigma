 RowBox[{
  RowBox[{"Eqn", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", "it"}], " ", 
        RowBox[{"D", "[", 
