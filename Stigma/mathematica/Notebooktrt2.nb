             RowBox[{
              RowBox[{"Derivative", "[", "it", "]"}], "[", "nn", "]"}], "[", 
             "t", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "it"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"it", ",", "0", ",", "2"}], "}"}]}], "]"}], "-", 
     RowBox[{
      RowBox[{"Rhos", "[", "t", "]"}], " ", 
      RowBox[{
       RowBox[{"aa", "[", "t", "]"}], "^", "3"}]}]}], "//", 
    "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Eqa", "=", 
