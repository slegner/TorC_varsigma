+ 4*stiigma^2)) + 
  a^2*a0^2*dcp^2*(3*cp^2*stiigma^2 + cp^4*(1 - 2*stiigma)^2*stiigma*(-3 + \
2*stiigma)*(1 + 2*stiigma) - stiigma^3*(1 + 8*stiigma) + cp^6*(1 - \
4*stiigma^2)^2)*v2 + 
  2*a*a0^2*cp*da*dcp*(stiigma + cp^2*(-1 + 4*stiigma^2))*((7 - \
4*stiigma)*stiigma^2 + 2*cp^2*stiigma*(1 + 2*(-3 + stiigma)*stiigma) + \
