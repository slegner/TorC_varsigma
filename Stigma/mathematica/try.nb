Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
     "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"PART", " ", "2"}], ":", 
    RowBox[{
    "Use", " ", "A1", " ", "solutions", " ", "to", " ", "find", " ", "other", 
     " ", "variables", " ", "for", " ", "each", " ", "branch"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
     "==="}], "="}], "*)"}], "\n", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "A1Sol", "]"}], ">", "0"}], ",", 
      RowBox[{
       RowBox[{"AllBranchSolutions", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"currentA1", "=", 
           RowBox[{"A1Sol", "[", 
            RowBox[{"[", "branchNum", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ZeroOrderConstraintSub", "=", 
           RowBox[{
            RowBox[{"ZeroOrderConstraint", "/.", " ", "currentA1"}], "//", 
            "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"ZeroOrderVarPiSub", "=", 
           RowBox[{
            RowBox[{"ZeroOrderVarPi", "/.", " ", "currentA1"}], "//", 
            "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"A2Pi1Sol", "=", 
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ZeroOrderConstraintSub", "==", "0"}], ",", 
               RowBox[{"ZeroOrderVarPiSub", "==", "0"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"VarPi1", ",", "ScaleFactor2"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"A2Pi1Sol", "=", 
           RowBox[{"A2Pi1Sol", "//", "FullSimplify"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"branchSols", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"currentA1", ",", "A2Pi1Sol"}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"AllBranchSolutions", ",", "branchSols"}], "]"}], ";"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"branchNum", ",", "1", ",", 
           RowBox[{"Length", "[", "A1Sol", "]"}]}], "}"}]}], "]"}], ";"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
      "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"PART", " ", "3"}], ":", "Simplify"}], ",", "save", ",", 
     RowBox[{
     "and", " ", "print", " ", "the", " ", "final", " ", "solutions"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
      "==="}], "="}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "1.", " ", "Initialize", " ", "empty", " ", "lists", " ", "to", " ", 
     "store", " ", "the", " ", "expressions", " ", "from", " ", "each", " ", 
     "branch"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aSolutions", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"VarPiSolutions", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"aDerivatives", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"VarPiDerivatives", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== SIMPLIFYING AND SAVING SOLUTIONS ===\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "This", " ", "loop", " ", "processes", " ", "and", " ", "simplifies", " ",
      "the", " ", "solutions", " ", "from", " ", "each", " ", "branch"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<=== Processing Branch \>\"", ",", "branchNum", ",", 
         "\"\< ===\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"FinalSols", "=", 
        RowBox[{"AllBranchSolutions", "[", 
         RowBox[{"[", "branchNum", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Apply", " ", "assumptions", " ", "and", " ", "fully", " ", 
         "simplify"}], "*)"}], 
       RowBox[{"assumptions", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Element", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "alps", ",", "stigma", ",", "VarPi0", ",", "VarPi1", ",", 
              "ScaleFactor1", ",", "ScaleFactor2", ",", "H0", ",", "OmegaM0", 
              ",", "OmegaR0", ",", "OmegaL0", ",", "Mp", ",", "ups2"}], "}"}],
             ",", "Reals"}], "]"}], ",", 
          RowBox[{"alps", ">", "0"}], ",", 
          RowBox[{"stigma", ">", "0"}], ",", 
          RowBox[{"ScaleFactor1", "!=", "0"}], ",", 
          RowBox[{"ups2", "<", "0"}], ",", 
          RowBox[{"Mp", ">", "0"}], ",", 
          RowBox[{"H0", ">", "0"}], ",", 
          RowBox[{"VarPi0", ">", "0"}], ",", 
          RowBox[{"VarPi0", "!=", "1"}], ",", 
          RowBox[{"OmegaM0", ">", "0"}], ",", 
          RowBox[{"OmegaR0", ">", "0"}], ",", 
          RowBox[{"stigma", ">", 
           RowBox[{"VarPi0", "^", "2"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"5", "*", "stigma"}], "-", 
            RowBox[{"VarPi0", "^", "2"}], "+", 
            RowBox[{"4", "*", 
             RowBox[{"stigma", "^", "2"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "2"}], "+", 
               RowBox[{"VarPi0", "^", "2"}]}], ")"}]}]}], ">", "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"VarPi0", "^", "2"}]}], "+", 
            RowBox[{"stigma", "*", 
             RowBox[{"(", 
              RowBox[{"5", "+", 
               RowBox[{"4", "*", "stigma", "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "2"}], "+", 
                  RowBox[{"VarPi0", "^", "2"}]}], ")"}]}]}], ")"}]}]}], ">", 
           "0"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"FinalSolsSimplified", "=", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{"FinalSols", ",", "assumptions"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Get", " ", "simplified", " ", "coefficients"}], "*)"}], 
       RowBox[{"a1Simplified", "=", 
        RowBox[{"ScaleFactor1", "/.", " ", "FinalSolsSimplified"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"a2Simplified", "=", 
        RowBox[{"ScaleFactor2", "/.", " ", "FinalSolsSimplified"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pi0Simplified", "=", 
        RowBox[{"VarPi0", "/.", " ", "FinalSolsSimplified"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pi1Simplified", "=", 
        RowBox[{"VarPi1", "/.", " ", "FinalSolsSimplified"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Construct", " ", "the", " ", "expressions", " ", "for", " ", "the", 
         " ", "solutions"}], "*)"}], 
       RowBox[{"aSol", "=", 
        RowBox[{
         RowBox[{"a1Simplified", "*", "tau"}], "+", 
         RowBox[{"a2Simplified", "*", 
          RowBox[{"tau", "^", "2"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"VarPiSol", "=", 
        RowBox[{"pi0Simplified", "+", 
         RowBox[{"pi1Simplified", "*", "tau"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"aDeriv", "=", 
        RowBox[{"D", "[", 
         RowBox[{"aSol", ",", "tau"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"VarPiDeriv", "=", 
        RowBox[{"D", "[", 
         RowBox[{"VarPiSol", ",", "tau"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "2.", " ", "Append", " ", "the", " ", "final", " ", "expressions", 
         " ", "for", " ", "this", " ", "branch", " ", "to", " ", "your", " ", 
         "lists"}], "*)"}], 
       RowBox[{"AppendTo", "[", 
        RowBox[{"aSolutions", ",", "aSol"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"VarPiSolutions", ",", "VarPiSol"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"aDerivatives", ",", "aDeriv"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"VarPiDerivatives", ",", "VarPiDeriv"}], "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"branchNum", ",", "1", ",", 
        RowBox[{"Length", "[", "AllBranchSolutions", "]"}]}], "}"}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Add", " ", "a", " ", "new", " ", "loop", " ", "to", " ", 
     "print", " ", "the", " ", "final", " ", "saved", " ", "solutions", " ", 
     "from", " ", "each", " ", "branch"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n=== FINAL SOLUTIONS ===\>\"", "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
