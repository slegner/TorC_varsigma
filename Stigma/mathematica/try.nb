Cell["\<\
(120000*a^4*a0^4*h^2*OmL*stiigma*(-cp^2 + stiigma)^2*(stiigma - 4*stiigma^2 + \
cp^2*(-1 + 4*stiigma^2)) - 40000*h^2*Omr*stiigma*(-cp^2 + stiigma)^2*(stiigma \
- 4*stiigma^2 + cp^2*(-1 + 4*stiigma^2)) - 
  a0^2*cp^2*da^2*((5 - 8*stiigma)*stiigma + cp^2*(-1 + 4*stiigma^2))*((7 - \
4*stiigma)*stiigma^2 + 2*cp^2*stiigma*(1 + 2*(-3 + stiigma)*stiigma) + \
cp^4*(-1 + 4*stiigma^2))*v2 + 
  a^2*a0^2*dcp^2*(stiigma^3 + 4*stiigma^4 - 32*stiigma^5 - cp^4*stiigma*(-1 + \
2*stiigma)*(1 + 2*stiigma)*(3 + 4*(-3 + stiigma)*stiigma) - cp^6*(1 - \
4*stiigma^2)^2 + cp^2*stiigma^2*(-3 + 8*stiigma + 16*stiigma^3))*v2 - 
  2*a*a0^2*cp*da*dcp*(cp^4*stiigma*(-1 + 2*stiigma)*(1 + 2*stiigma)*(11 + \
4*(-4 + stiigma)*stiigma) + cp^6*(1 - 4*stiigma^2)^2 + stiigma^3*(-1 + \
16*stiigma*(-2 + 3*stiigma)) + cp^2*stiigma^2*(11 - 16*stiigma*(1 + \
stiigma*(-1 + 2*stiigma))))*v2)/
 (8*a^2*a0^2*cp*stiigma*(-cp^2 + stiigma)^2*(-1 + 4*stiigma^2)*v2)\
\>", "Output",
