       RowBox[{"v1", "->", "..."}], ",", 
       RowBox[{"v2", "->", "..."}], ",", 
       RowBox[{"v3", "->", "..."}]}], "}"}], "."}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
