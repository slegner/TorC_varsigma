         RowBox[{
          RowBox[{"nn", "[", "t", "]"}], ">", "0"}]}], "}"}]}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Lnew", ":=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
