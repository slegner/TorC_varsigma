       RowBox[{"{", 
        RowBox[{
         RowBox[{"sig1", "->", 
          RowBox[{"sig2", " ", "stigma"}]}], ",", 
         RowBox[{"ups1", "->", "0"}], ",", 
         RowBox[{
          RowBox[{"Psis", "[", "t", "]"}], "->", 
          RowBox[{
