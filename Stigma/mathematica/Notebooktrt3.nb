Cell[BoxData[{
 RowBox[{
  RowBox[{"DefChart", "[", 
   RowBox[{"ch", ",", "M", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "[", "]"}], ",", 
      RowBox[{"x", "[", "]"}], ",", 
      RowBox[{"y", "[", "]"}], ",", 
      RowBox[{"z", "[", "]"}]}], "}"}], ",", 
    RowBox[{"ChartColor", "->", "Purple"}]}], "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DefScalarFunction", "[", 
   RowBox[{"nn", ",", 
    RowBox[{"PrintAs", "->", "\"\<N\>\""}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DefScalarFunction", "[", 
    RowBox[{"aa", ",", 
     RowBox[{"PrintAs", "->", "\"\<a\>\""}]}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"metricmatrix", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"nn", "[", 
         RowBox[{"t", "[", "]"}], "]"}], "^", "2"}], ",", "0", ",", "0", ",", 
       "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"aa", "[", 
          RowBox[{"t", "[", "]"}], "]"}], "^", "2"}]}], ",", "0", ",", "0"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"aa", "[", 
          RowBox[{"t", "[", "]"}], "]"}], "^", "2"}]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"aa", "[", 
          RowBox[{"t", "[", "]"}], "]"}], "^", "2"}]}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"metric", "=", 
  RowBox[{"CTensor", "[", 
   RowBox[{"metricmatrix", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "ch"}], ",", 
      RowBox[{"-", "ch"}]}], "}"}]}], "]"}]}], "\n", 
 RowBox[{"SetCMetric", "[", 
  RowBox[{"metric", ",", "ch", ",", 
   RowBox[{"SignatureOfMetric", "->", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3", ",", "0"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"cd", "=", 
  RowBox[{"CovDOfMetric", "[", "metric", "]"}]}], "\n", 
 RowBox[{"detg", "=", 
  RowBox[{"Det", "[", "metricmatrix", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Riemanncd", "=", 
   RowBox[{"Riemann", "[", "cd", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Riccicd", "=", 
