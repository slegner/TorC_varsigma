Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"LTemp", ":=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"L", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"t", "[", "]"}], "->", "t"}], "}"}]}], ",", 
